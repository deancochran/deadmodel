{
  "name": "deadmodel",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "vite dev --port 3000",
    "build": "vite build && npm run typecheck",
